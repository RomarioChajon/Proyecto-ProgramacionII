<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="umg.sigelab.view.LoginForm">
  <grid id="lgRoot" binding="panelPrincipal" layout-manager="GridLayoutManager" row-count="4" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="14" left="14" bottom="14" right="14"/>
    <constraints>
      <xy x="20" y="20" width="480" height="560"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <component id="lgTitle" class="javax.swing.JLabel" binding="lblTitulo">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <font size="28" style="1"/>
          <horizontalAlignment value="0"/>
          <text value="SIGELAB"/>
        </properties>
      </component>
      <component id="lgSub" class="javax.swing.JLabel" binding="lblSubtitulo">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <horizontalAlignment value="0"/>
          <text value="Sistema de Gestión y Control de Laboratorios"/>
        </properties>
      </component>
      <tabbedpane id="lgTabs" binding="tabs">
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <grid id="lgIn" layout-manager="GridLayoutManager" row-count="4" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
            <margin top="14" left="14" bottom="14" right="14"/>
            <constraints>
              <tabbedpane title="Ingresar"/>
            </constraints>
            <properties/>
            <border type="none"/>
            <children>
              <component id="lgUsrL" class="javax.swing.JLabel">
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="Usuario"/>
                </properties>
              </component>
              <component id="lgUsr" class="javax.swing.JTextField" binding="txtUsuario">
                <constraints>
                  <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                    <preferred-size width="150" height="-1"/>
                  </grid>
                </constraints>
                <properties/>
              </component>
              <component id="lgPassL" class="javax.swing.JLabel">
                <constraints>
                  <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="Contraseña"/>
                </properties>
              </component>
              <component id="lgPass" class="javax.swing.JPasswordField" binding="txtPassword">
                <constraints>
                  <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                    <preferred-size width="150" height="-1"/>
                  </grid>
                </constraints>
                <properties/>
              </component>
              <component id="lgIngresar" class="javax.swing.JButton" binding="btnIngresar">
                <constraints>
                  <grid row="2" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="INGRESAR"/>
                </properties>
              </component>
              <component id="lgAyuda" class="javax.swing.JLabel" binding="lblAyudaIngreso">
                <constraints>
                  <grid row="3" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <horizontalAlignment value="0"/>
                  <text value="&lt;html&gt;&lt;center&gt;Se verificará su contraseña y después su rostro.&lt;br&gt;Se abrirá la cámara: siga las instrucciones.&lt;/center&gt;&lt;/html&gt;"/>
                </properties>
              </component>
            </children>
          </grid>
          <grid id="lgReg" layout-manager="GridLayoutManager" row-count="9" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
            <margin top="14" left="14" bottom="14" right="14"/>
            <constraints>
              <tabbedpane title="Regístrate"/>
            </constraints>
            <properties/>
            <border type="none"/>
            <children>
              <component id="rgNomL" class="javax.swing.JLabel">
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="Nombre *"/>
                </properties>
              </component>
              <component id="rgNom" class="javax.swing.JTextField" binding="txtRegNombre">
                <constraints>
                  <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                    <preferred-size width="150" height="-1"/>
                  </grid>
                </constraints>
                <properties/>
              </component>
              <component id="rgApeL" class="javax.swing.JLabel">
                <constraints>
                  <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="Apellido *"/>
                </properties>
              </component>
              <component id="rgApe" class="javax.swing.JTextField" binding="txtRegApellido">
                <constraints>
                  <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                    <preferred-size width="150" height="-1"/>
                  </grid>
                </constraints>
                <properties/>
              </component>
              <component id="rgUsrL" class="javax.swing.JLabel">
                <constraints>
                  <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="Usuario *"/>
                </properties>
              </component>
              <component id="rgUsr" class="javax.swing.JTextField" binding="txtRegUsuario">
                <constraints>
                  <grid row="2" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                    <preferred-size width="150" height="-1"/>
                  </grid>
                </constraints>
                <properties/>
              </component>
              <component id="rgMailL" class="javax.swing.JLabel">
                <constraints>
                  <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="Correo *"/>
                </properties>
              </component>
              <component id="rgMail" class="javax.swing.JTextField" binding="txtRegCorreo">
                <constraints>
                  <grid row="3" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                    <preferred-size width="150" height="-1"/>
                  </grid>
                </constraints>
                <properties/>
              </component>
              <component id="rgPassL" class="javax.swing.JLabel">
                <constraints>
                  <grid row="4" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="Contraseña *"/>
                </properties>
              </component>
              <component id="rgPass" class="javax.swing.JPasswordField" binding="txtRegPassword">
                <constraints>
                  <grid row="4" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                    <preferred-size width="150" height="-1"/>
                  </grid>
                </constraints>
                <properties/>
              </component>
              <component id="rgPass2L" class="javax.swing.JLabel">
                <constraints>
                  <grid row="5" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="Repetir contraseña *"/>
                </properties>
              </component>
              <component id="rgPass2" class="javax.swing.JPasswordField" binding="txtRegPassword2">
                <constraints>
                  <grid row="5" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                    <preferred-size width="150" height="-1"/>
                  </grid>
                </constraints>
                <properties/>
              </component>
              <component id="rgAviso" class="javax.swing.JLabel" binding="lblAvisoColaborador">
                <constraints>
                  <grid row="6" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                    <preferred-size width="380" height="44"/>
                  </grid>
                </constraints>
                <properties>
                  <foreground color="-4959479"/>
                  <text value="&lt;html&gt;Si usted es colaborador de la institución por favor contactarse con el administrador.&lt;br&gt;(Todas las cuentas nuevas se crean como estudiante.)&lt;/html&gt;"/>
                </properties>
              </component>
              <component id="rgBtn" class="javax.swing.JButton" binding="btnRegistrar">
                <constraints>
                  <grid row="7" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="REGISTRARME Y CAPTURAR ROSTRO"/>
                </properties>
              </component>
              <component id="rgAyuda" class="javax.swing.JLabel">
                <constraints>
                  <grid row="8" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <horizontalAlignment value="0"/>
                  <text value="&lt;html&gt;&lt;center&gt;Se abrirá la cámara para registrar su rostro.&lt;/center&gt;&lt;/html&gt;"/>
                </properties>
              </component>
            </children>
          </grid>
          <grid id="lgRes" layout-manager="GridLayoutManager" row-count="8" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
            <margin top="14" left="14" bottom="14" right="14"/>
            <constraints>
              <tabbedpane title="Reiniciar contraseña"/>
            </constraints>
            <properties/>
            <border type="none"/>
            <children>
              <component id="rsUsrL" class="javax.swing.JLabel">
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="Usuario"/>
                </properties>
              </component>
              <component id="rsUsr" class="javax.swing.JTextField" binding="txtResUsuario">
                <constraints>
                  <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                    <preferred-size width="150" height="-1"/>
                  </grid>
                </constraints>
                <properties/>
              </component>
              <component id="rsMailL" class="javax.swing.JLabel">
                <constraints>
                  <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="Correo"/>
                </properties>
              </component>
              <component id="rsMail" class="javax.swing.JTextField" binding="txtResCorreo">
                <constraints>
                  <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                    <preferred-size width="150" height="-1"/>
                  </grid>
                </constraints>
                <properties/>
              </component>
              <component id="rsVerif" class="javax.swing.JButton" binding="btnVerificarRostro">
                <constraints>
                  <grid row="2" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="VERIFICAR CON RECONOCIMIENTO FACIAL"/>
                </properties>
              </component>
              <component id="rsEstado" class="javax.swing.JLabel" binding="lblEstadoReinicio">
                <constraints>
                  <grid row="3" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <horizontalAlignment value="0"/>
                  <text value="Paso 1: escriba su usuario y correo, y verifique su rostro."/>
                </properties>
              </component>
              <component id="rsNuevaL" class="javax.swing.JLabel">
                <constraints>
                  <grid row="4" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="Nueva contraseña"/>
                </properties>
              </component>
              <component id="rsNueva" class="javax.swing.JPasswordField" binding="txtResNueva">
                <constraints>
                  <grid row="4" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                    <preferred-size width="150" height="-1"/>
                  </grid>
                </constraints>
                <properties/>
              </component>
              <component id="rsNueva2L" class="javax.swing.JLabel">
                <constraints>
                  <grid row="5" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="Repetir contraseña"/>
                </properties>
              </component>
              <component id="rsNueva2" class="javax.swing.JPasswordField" binding="txtResNueva2">
                <constraints>
                  <grid row="5" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                    <preferred-size width="150" height="-1"/>
                  </grid>
                </constraints>
                <properties/>
              </component>
              <component id="rsGuardar" class="javax.swing.JButton" binding="btnGuardarNueva">
                <constraints>
                  <grid row="6" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="GUARDAR NUEVA CONTRASEÑA"/>
                </properties>
              </component>
              <component id="rsAyuda" class="javax.swing.JLabel">
                <constraints>
                  <grid row="7" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <horizontalAlignment value="0"/>
                  <text value="&lt;html&gt;&lt;center&gt;La nueva contraseña se habilita solo si su rostro coincide.&lt;/center&gt;&lt;/html&gt;"/>
                </properties>
              </component>
            </children>
          </grid>
        </children>
      </tabbedpane>
      <grid id="lgFoot" layout-manager="GridLayoutManager" row-count="1" column-count="3" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints>
          <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="lgSvc" class="javax.swing.JLabel" binding="lblEstadoServicio">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Servicio facial: comprobando..."/>
            </properties>
          </component>
          <component id="lgBtnSvc" class="javax.swing.JButton" binding="btnServicioFacial">
            <constraints>
              <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="1" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Servicio facial..."/>
            </properties>
          </component>
          <component id="lgExit" class="javax.swing.JButton" binding="btnSalir">
            <constraints>
              <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="SALIR"/>
            </properties>
          </component>
        </children>
      </grid>
    </children>
  </grid>
</form>
